{
  "name": "alan-pipeline",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic, code-driven vector animation studio (Motion Canvas + TypeScript).",
  "type": "module",
  "scripts": {
    "start": "vite",
    "serve": "vite --host",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "doctor": "node scripts/doctor.mjs",
    "render": "node scripts/render.mjs",
    "audio:placeholder": "node scripts/make-placeholder-audio.mjs",
    "render:space": "node scripts/render.mjs --project=space_duel --strict",
    "audio:space": "python tools/build_space_audio.py"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2"
  },
  "devDependencies": {
    "@motion-canvas/ffmpeg": "3.17.2",
    "@motion-canvas/ui": "3.17.2",
    "@motion-canvas/vite-plugin": "3.17.2",
    "@types/node": "^20.19.43",
    "playwright-core": "^1.56.1",
    "typescript": "~5.6.3",
    "vite": "~5.4.11"
  }
}
